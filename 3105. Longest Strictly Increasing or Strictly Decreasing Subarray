class Solution:
    def longestMonotonicSubarray(self, nums: List[int]) -> int:
        n = len(nums)
        incLen = 1
        decLen = 1
        maxLen = 1

        for i in range(1, n):
            if nums[i] > nums[i - 1]:
                incLen += 1
                decLen = 1

            elif nums[i] < nums[i - 1]:
                decLen += 1
                incLen = 1

            else:
                decLen = 1
                incLen = 1

            maxLen = max(maxLen, incLen, decLen)

        return maxLen
