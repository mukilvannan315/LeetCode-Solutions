class Solution:
    def maxVowels(self, s: str, k: int) -> int:
        left = 0
        right = k
        count = 0


        for i in range(k):
            if s[i] in 'aeiou':
                count += 1

        max_count = count

        while right < len(s):
            if s[left] in 'aeiou':
                count -= 1
            if s[right] in 'aeiou':
                count += 1
            if count > max_count:
                max_count = count

            left += 1
            right += 1

        return max_count
