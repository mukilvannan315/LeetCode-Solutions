class Solution:
    def searchInsert(self, nums: list[int], target: int) -> int:
        low = 0
        high = len(nums)-1

       
        while low <= high: 
            middle = (low + high) // 2 
            if nums[middle] == target:
                return middle
            if target > nums[middle]:
                low = middle +1
            elif target < nums[middle]:
                high = middle -1

        return low
